version: 1

labels:
  pause: loop-pause-all
  lock: loop:repairing
  bug: bug
  attemptsPrefix: "loop:attempts:"
  # Highest priority first. Labels are optional; unlabeled targets score zero.
  priority: [priority:critical, priority:high, priority:medium, priority:low]
  sensitive: [security, area:auth, area:billing, area:migrations, area:deployment]

maxAttempts: 3

sensitivePaths:
  - ".github/**"
  - "deploy/**"
  - "**/migrations/**"
  - "**/auth/**"
  - "**/*secret*"
